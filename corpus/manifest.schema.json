{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Round manifest",
  "description": "Ground truth for one round. See specs/03-manifest-schema.md.",
  "type": "object",
  "required": ["round", "title", "base", "defects", "pathologies", "cleanControl"],
  "additionalProperties": false,
  "properties": {
    "round": { "type": "integer", "minimum": 0 },
    "title": { "type": "string", "minLength": 1 },
    "base": { "type": "string", "minLength": 1 },
    "diffLines": { "type": "integer", "minimum": 1 },
    "cleanControl": { "type": "boolean" },
    "defects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "class", "file", "line", "summary", "caughtBy", "evidence", "action", "reserved"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^R\\d+-D\\d+$" },
          "class": { "enum": ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8"] },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "summary": { "type": "string" },
          "caughtBy": { "type": ["string", "null"] },
          "evidence": { "enum": ["counterexample", "proof", "statistical", "corroborated", "opinion", "silence"] },
          "action": { "enum": ["confirm", "refute", "escalate", "ignore"] },
          "reserved": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "pathologies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "check", "file", "summary", "action", "reason"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^R\\d+-P\\d+$" },
          "kind": { "enum": ["false-positive", "fluent-wrong-review", "equivalent-mutant", "green-because-unexamined"] },
          "check": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "summary": { "type": "string" },
          "action": { "enum": ["confirm", "refute", "escalate", "ignore"] },
          "reason": { "type": "string" }
        }
      }
    }
  }
}
