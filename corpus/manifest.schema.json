{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Round manifest",
  "description": "Ground truth for one round. See specs/03-manifest-schema.md.",
  "type": "object",
  "required": [
    "round",
    "title",
    "base",
    "defects",
    "pathologies",
    "cleanControl",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "diffLines": {
      "type": "integer",
      "minimum": 1
    },
    "cleanControl": {
      "type": "boolean"
    },
    "defects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "file",
          "line",
          "summary",
          "caughtBy",
          "evidence",
          "action",
          "reserved"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R\\d+-D\\d+$"
          },
          "class": {
            "enum": [
              "F1",
              "F2",
              "F3",
              "F4",
              "F5",
              "F6",
              "F7",
              "F8"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "summary": {
            "type": "string"
          },
          "caughtBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "enum": [
              "counterexample",
              "proof",
              "statistical",
              "corroborated",
              "opinion",
              "silence"
            ]
          },
          "action": {
            "enum": [
              "confirm",
              "refute",
              "escalate",
              "ignore"
            ]
          },
          "reserved": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "pathologies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "check",
          "file",
          "summary",
          "action",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R\\d+-P\\d+$"
          },
          "kind": {
            "enum": [
              "false-positive",
              "fluent-wrong-review",
              "equivalent-mutant",
              "green-because-unexamined"
            ]
          },
          "check": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "summary": {
            "type": "string"
          },
          "action": {
            "enum": [
              "confirm",
              "refute",
              "escalate",
              "ignore"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Who authored the change under validation. F5 is about self-approval, so this is evidence, not metadata. It lives here rather than in git authorship because forks and rebases destroy commit metadata.",
      "required": [
        "author",
        "selfReview"
      ],
      "additionalProperties": false,
      "properties": {
        "author": {
          "enum": [
            "agent",
            "human",
            "pair"
          ]
        },
        "model": {
          "type": "string"
        },
        "transcript": {
          "type": [
            "string",
            "null"
          ],
          "description": "Path to the authoring session, or null when not yet recorded."
        },
        "selfReview": {
          "type": "string",
          "description": "What the author claimed about their own work."
        }
      }
    }
  }
}
