        "writes": "bundles/<timestamp>.json",
        "summary": "Run the workflow and emit an evidence bundle."
      },
      {
        "name": "report",
        "summary": "Read the latest bundle and name the classes nothing examined."
      },
      {
        "name": "review",
        "flags": [
          "--fresh-context"
        ],
        "summary": "Invoke the zero-context review skill."
      }
    ]
  },
